# ==============================================================================
# CF STALKER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development
# ==============================================================================

# Application Environment
APP_NAME="CF Stalker"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="change-this-to-a-secure-random-secret-key-in-production"

# API Settings
API_V1_STR="/api/v1"
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cf_stalker
# DB_URL can be constructed dynamically or supplied directly:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cf_stalker

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Codeforces API Settings
CF_API_BASE_URL=https://codeforces.com/api
CF_API_RATE_LIMIT_DELAY=2.0  # seconds between requests

# AI Performance Coach (LLM API)
LLM_PROVIDER=openai  # openai | gemini | anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Security & JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
